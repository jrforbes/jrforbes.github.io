  TITLE =        "{Dual Approaches to Strictly Positive Real Controller Synthesis with a $H_2$ Performance Using Linear Matrix Inequalities}",
  JOURNAL =      "International Journal of Robust and Nonlinear Control",
  YEAR =         {2013},
  volume =       {23},
  number =       {8},
  pages =        {903--918},
  month =        "",
  note =         {},
  abstract =     {The synthesis of controllers that minimize a H_2 performance index subject to a strictly positive real (SPR) constraint is considered. Two controller synthesis methods are presented that are then combined into an iterative algorithm. Each method synthesizes optimal SPR controllers by posing a convex optimization problem where constraints are enforced via linear matrix inequalities. Additionally, each method fixes the controller state-feedback gain matrix and finds an observer gain matrix such that an upper bound on the closed-loop H_2-norm is minimized and the controller is SPR. The first method retools the standard H_2 control problem by using a common Lyapunov matrix variable to satisfy both the H_2 criteria and the SPR constraint. The second method overcomes bilinear matrix inequality issues associated with the H_2 performance and the SPR constraint by employing a completing the square method and an overbounding technique. Both synthesis methods are used within an iterative scheme to find optimal SPR controllers in a sequential manner. Comparison of our synthesis methods to existing methods in the literature is presented.},
  keywords =     {},
  source =       {},
}

@ARTICLE{paper_forbes_hybrid_two_link_2013,
  AUTHOR =       "James Richard Forbes and Christopher John Damaren",
  TITLE =        "{Overcoming Passivity Violations: Closed-Loop Stability, Controller Design, and Controller Scheduling}",
  JOURNAL =      "IET Control Theory and Applications",
  YEAR =         {2013},
