

@ARTICLE{paper_Guo_IROS2026,
  AUTHOR =       "Zi Cong Guo* and James Richard Forbes and Timothy Barfoot",
  TITLE =        "{KILO-EKF: Koopman-Inspired Learned Observations Extended Kalman Filter}",
